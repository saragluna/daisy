<Window x:Class="Daisy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daisy"
        Width="940"
        Height="700"
        MinWidth="780"
        MinHeight="560"
        Icon="Assets/AppIcon.png"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Daisy" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Local Copilot proxy stack" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SummaryDot" Width="8" Height="8" Fill="#FFF59E0B" Margin="0,0,7,0" />
                        <TextBlock x:Name="RunningSummaryText" Text="0/2 running" FontWeight="Medium" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" BorderThickness="0" Background="White" Padding="12">
            <TabItem Header="Services">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,18">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontFamily="Consolas" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF9CA3AF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="#FF22C55E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LastError}" Foreground="#FFDC2626"
                                                   TextWrapping="Wrap" Margin="0,10,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="Start" Tag="{Binding Id}" Click="ServiceStart_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Stop" Tag="{Binding Id}" Click="ServiceStop_Click" IsEnabled="{Binding IsRunning}" />
                                            <Button Content="Restart" Tag="{Binding Id}" Click="ServiceRestart_Click" IsEnabled="{Binding IsRunning}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Models">
                <Grid Margin="8,14,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModelSearchBox" TextChanged="ModelSearchBox_TextChanged" Margin="0,0,10,0"
                                 ToolTip="Filter models" />
                        <Button Grid.Column="1" x:Name="RefreshModelsButton" Content="Refresh Models" Click="RefreshModels_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="ModelsStatusText" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,10" />
                    <ListBox Grid.Row="2" x:Name="ModelsList" ItemsSource="{Binding VisibleModels}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="12,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding}" Click="ModelAction_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Config">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,18">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="copilot-api" FontSize="17" FontWeight="SemiBold" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <PasswordBox x:Name="TokenPasswordBox" PasswordChanged="TokenPasswordBox_PasswordChanged" />
                                        <TextBox x:Name="TokenTextBox" TextChanged="TokenTextBox_TextChanged" Visibility="Collapsed" />
                                    </Grid>
                                    <CheckBox Grid.Column="1" x:Name="ShowTokenCheckBox" Content="Show" Margin="12,0,0,0"
                                              VerticalAlignment="Center" Checked="ShowToken_Changed" Unchecked="ShowToken_Changed" />
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Save Token" Click="SaveToken_Click" />
                                    <Button x:Name="GetTokenButton" Content="Get Copilot Token" Click="GetToken_Click" />
                                    <Button Content="Restart copilot-api" Click="RestartCopilot_Click" />
                                </WrapPanel>
                                <Border x:Name="DeviceFlowPanel" Visibility="Collapsed" Background="#FFEFF6FF" CornerRadius="6"
                                        Padding="10" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Enter code: " VerticalAlignment="Center" />
                                        <TextBlock x:Name="DeviceCodeText" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Copy" Click="CopyDeviceCode_Click" Margin="12,0,0,0" />
                                        <Button Content="Cancel" Click="CancelDeviceFlow_Click" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Stored securely in Windows Credential Manager" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="LiteLLM Proxy" FontSize="17" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,12,0,8">
                                    <TextBlock Text="Version" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="LiteLlmVersionBox" Width="170" ToolTip="Use an exact version, such as 1.101.0" />
                                    <Button Content="Save Version" Click="SaveLiteLlmVersion_Click" />
                                    <TextBlock x:Name="InstalledVersionText" VerticalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0" />
                                    <Button Content="Refresh Version" Click="RefreshInstalledVersion_Click" />
                                </WrapPanel>
                                <TextBox x:Name="LiteLlmConfigBox" Height="220" AcceptsReturn="True" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" TextWrapping="NoWrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Save Config" Click="SaveLiteLlmConfig_Click" />
                                    <Button Content="Restart LiteLLM Proxy" Click="RestartLiteLlm_Click" />
                                </WrapPanel>
                                <TextBlock Text="%LOCALAPPDATA%\Daisy\litellm-config.yaml" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Claude Code" FontSize="17" FontWeight="SemiBold" />
                                <TextBox x:Name="ClaudeSettingsBox" Height="250" AcceptsReturn="True" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" TextWrapping="NoWrap" Margin="0,12,0,0" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Format JSON" Click="FormatClaudeSettings_Click" />
                                    <Button Content="Save Settings" Click="SaveClaudeSettings_Click" />
                                </WrapPanel>
                                <TextBlock Text="%USERPROFILE%\.claude\settings.json" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Windows" FontSize="17" FontWeight="SemiBold" />
                                <CheckBox x:Name="OpenAtLoginCheckBox" Content="Open Daisy when I sign in"
                                          Margin="0,12,0,0" Checked="OpenAtLogin_Changed" Unchecked="OpenAtLogin_Changed" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ConfigMessageText" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="4,0,4,14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="8,14,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LogServiceFilter" SelectionChanged="LogFilter_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="All services" Tag="All" />
                            <ComboBoxItem Content="copilot-api" Tag="CopilotApi" />
                            <ComboBoxItem Content="LiteLLM Proxy" Tag="LiteLlmProxy" />
                        </ComboBox>
                        <TextBox Grid.Column="1" x:Name="LogSearchBox" TextChanged="LogFilter_Changed" Margin="10,0,0,0"
                                 ToolTip="Filter logs" />
                    </Grid>
                    <TextBox Grid.Row="1" x:Name="LogsTextBox" Margin="0,10,0,10" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="LogLineCountText" Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="3" Content="Clear" Click="ClearLogs_Click" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
